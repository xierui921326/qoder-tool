{
  "name": "qoder-account-manager",
  "version": "1.0.0",
  "description": "自动化Qoder账号注册和管理工具",
  "main": "src/electron/main.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "electron": "electron .",
    "electron-dev": "NODE_ENV=development electron .",
    "build": "electron-builder",
    "build-win": "electron-builder --win",
    "build-mac": "electron-builder --mac",
    "build-linux": "electron-builder --linux",
    "test": "node --test test/**/*.test.js",
    "test:watch": "node --test --watch test/**/*.test.js",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix"
  },
  "keywords": [
    "qoder",
    "automation",
    "account-management",
    "web-scraping",
    "email-automation"
  ],
  "author": "Qoder Account Manager",
  "license": "MIT",
  "dependencies": {
    "chalk": "^5.3.0",
    "cheerio": "^1.0.0-rc.12",
    "commander": "^11.1.0",
    "fast-check": "^3.15.0",
    "imap": "^0.8.19",
    "inquirer": "^9.2.12",
    "mailparser": "^3.9.1",
    "nodemailer": "^6.9.7",
    "ora": "^7.0.1",
    "playwright": "^1.40.0",
    "sqlite3": "^5.1.6",
    "electron": "^28.0.0",
    "express": "^4.18.2",
    "cors": "^2.8.5"
  },
  "devDependencies": {
    "eslint": "^8.55.0",
    "electron-builder": "^24.9.1",
    "concurrently": "^8.2.2",
    "wait-on": "^7.2.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "build": {
    "appId": "com.qoder.account-manager",
    "productName": "Qoder账号管理器",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": "dmg"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
