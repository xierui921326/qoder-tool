{
  "name": "qoder-account-manager",
  "version": "1.0.0",
  "description": "自动化Qoder账号注册和管理工具 - Monorepo根目录",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:desktop": "cd apps/desktop && npm run dev",
    "dev:node-core": "cd apps/node-core && npm start",
    "build:desktop": "cd apps/desktop && npm run build",
    "build:node-core": "cd apps/node-core && npm run build",
    "test": "npm run test --workspaces",
    "test:node-core": "cd apps/node-core && npm test",
    "clean": "rm -rf node_modules apps/*/node_modules apps/*/dist"
  },
  "keywords": [
    "qoder",
    "automation",
    "account-management",
    "web-scraping",
    "email-automation",
    "tauri",
    "rust",
    "monorepo"
  ],
  "author": "Qoder Account Manager Team",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  }
}
